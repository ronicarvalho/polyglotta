<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Polyglotta.Tray.TranscriptWindow"
        Title="Polyglotta — Transcrição"
        Width="680" Height="420"
        MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.75" FontSize="12"
                 TextWrapping="Wrap"
                 Text="O que foi reconhecido e como foi traduzido, nos dois sentidos. Só frases finais aparecem aqui." />
      <Button Grid.Column="1" x:Name="ClearButton" Content="Limpar" MinWidth="96"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Margin="12,0,0,0" />
    </Grid>

    <Border BorderBrush="#30808080" BorderThickness="1" CornerRadius="6">
      <ListBox x:Name="Lines" FontFamily="Consolas,monospace" FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Border>

  </DockPanel>
</Window>
